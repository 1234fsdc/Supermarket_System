.promo-entry-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background-color: #fff;
  padding: 20rpx 0;
  margin: 20rpx 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.promo-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.promo-icon {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.coupon-icon {
  background: linear-gradient(135deg, #E95F3C 0%, #ff7a5c 100%);
}

.seckill-icon {
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%);
}

.mycoupon-icon {
  background: linear-gradient(135deg, #ffc200 0%, #ffdb4d 100%);
  color: #333;
}

.promo-text {
  font-size: 24rpx;
  color: #333;
}

.promo-divider {
  width: 1rpx;
  height: 60rpx;
  background-color: #eee;
}
