.search-container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background-color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.search-input-box {
  flex: 1;
  display: flex;
  align-items: center;
  height: 72rpx;
  background-color: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 24rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.clear-icon {
  width: 32rpx;
  height: 32rpx;
  margin-left: 16rpx;
}

.search-btn {
  margin-left: 20rpx;
  padding: 0 24rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  color: #E95F3C;
  font-weight: 500;
}

/* 搜索历史 */
.search-history {
  padding: 40rpx 24rpx;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.history-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.clear-history {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.delete-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.history-tags {
  display: flex;
  flex-wrap: wrap;
}

.history-tag {
  padding: 12rpx 24rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  background-color: #fff;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

/* 搜索结果 */
.search-result {
  padding: 20rpx 24rpx;
}

.product-count {
  padding: 20rpx 0;
  font-size: 26rpx;
  color: #999;
}

/* 商品列表 */
.product-item {
  display: flex;
  padding: 24rpx;
  margin-bottom: 20rpx;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.product-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

.product-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

.product-bottom {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 20rpx;
}

.product-price {
  color: #E94E3C;
}

.price-symbol {
  font-size: 22rpx;
}

.price-number {
  font-size: 36rpx;
  font-weight: 600;
}

.product-sales {
  font-size: 22rpx;
  color: #999;
}

.out-stock {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

/* 空状态 */
.empty-result {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-img {
  width: 300rpx;
  height: 300rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
