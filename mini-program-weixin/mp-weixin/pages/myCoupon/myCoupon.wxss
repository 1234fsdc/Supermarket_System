.my-coupon-page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.my-coupon-content {
  padding-top: 88rpx;
}

/* 状态标签 */
.status-tabs {
  display: flex;
  background-color: #fff;
  padding: 0 30rpx;
  border-bottom: 1rpx solid #eee;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #E95F3C;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background-color: #E95F3C;
  border-radius: 2rpx;
}

.badge {
  display: inline-block;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  background-color: #E95F3C;
  color: #fff;
  font-size: 20rpx;
  border-radius: 16rpx;
  margin-left: 8rpx;
  padding: 0 8rpx;
}

/* 优惠券列表 */
.coupon-list {
  padding: 20rpx;
}

.coupon-card {
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.coupon-card.used {
  opacity: 0.7;
}

.coupon-card.used .coupon-left {
  background: linear-gradient(135deg, #999 0%, #bbb 100%);
}

.coupon-card.expired {
  opacity: 0.6;
}

.coupon-card.expired .coupon-left {
  background: linear-gradient(135deg, #999 0%, #bbb 100%);
}

.coupon-main {
  display: flex;
  padding: 24rpx;
}

.coupon-left {
  width: 160rpx;
  background: linear-gradient(135deg, #E95F3C 0%, #ff7a5c 100%);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 10rpx;
  margin-right: 24rpx;
}

.coupon-value {
  display: flex;
  align-items: baseline;
  color: #fff;
}

.coupon-value .currency {
  font-size: 24rpx;
}

.coupon-value .amount {
  font-size: 44rpx;
  font-weight: bold;
}

.coupon-value .unit {
  font-size: 24rpx;
}

.coupon-type {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
}

.coupon-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.coupon-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.coupon-condition {
  font-size: 24rpx;
  color: #E95F3C;
  margin-bottom: 6rpx;
}

.coupon-time {
  font-size: 22rpx;
  color: #999;
}

.coupon-right {
  display: flex;
  align-items: center;
  margin-left: 20rpx;
}

.status-tag {
  padding: 6rpx 16rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  background-color: #f5f5f5;
  color: #999;
}

.status-tag.unused {
  background-color: #fff2f0;
  color: #E95F3C;
}

.status-tag.used-tag {
  background-color: #f0f0f0;
  color: #999;
}

.status-tag.expired-tag {
  background-color: #f0f0f0;
  color: #999;
}

.coupon-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  border-top: 1rpx dashed #eee;
}

.footer-info {
  font-size: 22rpx;
  color: #999;
}

.use-btn {
  width: 120rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background: linear-gradient(135deg, #E95F3C 0%, #ff7a5c 100%);
  color: #fff;
  font-size: 22rpx;
  border-radius: 24rpx;
  padding: 0;
  margin: 0;
  border: none;
}

.use-btn::after {
  border: none;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.go-coupon-btn {
  width: 240rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: linear-gradient(135deg, #E95F3C 0%, #ff7a5c 100%);
  color: #fff;
  font-size: 28rpx;
  border-radius: 36rpx;
  padding: 0;
  margin: 0;
  border: none;
}

.go-coupon-btn::after {
  border: none;
}
