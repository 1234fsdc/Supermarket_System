.coupon-page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.coupon-content {
  padding-top: 88rpx;
}

/* 标签栏 */
.coupon-tabs {
  display: flex;
  background-color: #fff;
  padding: 0 30rpx;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #E95F3C;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background-color: #E95F3C;
  border-radius: 2rpx;
}

/* 优惠券列表 */
.coupon-list {
  padding: 20rpx;
}

.coupon-item {
  display: flex;
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  position: relative;
}

.coupon-item.received {
  opacity: 0.7;
}

.coupon-item.received::before {
  content: '已领取';
  position: absolute;
  top: 20rpx;
  right: -40rpx;
  width: 160rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background-color: #999;
  color: #fff;
  font-size: 22rpx;
  transform: rotate(45deg);
  z-index: 2;
}

.coupon-left {
  width: 200rpx;
  background: linear-gradient(135deg, #E95F3C 0%, #ff7a5c 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30rpx 20rpx;
  position: relative;
}

.coupon-left::before,
.coupon-left::after {
  content: '';
  position: absolute;
  right: -16rpx;
  width: 32rpx;
  height: 32rpx;
  background-color: #f5f5f5;
  border-radius: 50%;
}

.coupon-left::before {
  top: -16rpx;
}

.coupon-left::after {
  bottom: -16rpx;
}

.coupon-value {
  display: flex;
  align-items: baseline;
  color: #fff;
}

.coupon-value .currency {
  font-size: 28rpx;
  font-weight: 600;
}

.coupon-value .amount {
  font-size: 56rpx;
  font-weight: bold;
  line-height: 1;
}

.coupon-value .unit {
  font-size: 28rpx;
}

.coupon-type-tag {
  margin-top: 12rpx;
  padding: 4rpx 16rpx;
  background-color: rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 22rpx;
  border-radius: 20rpx;
}

.coupon-divider {
  width: 2rpx;
  background-color: #f0f0f0;
  position: relative;
}

.coupon-right {
  flex: 1;
  padding: 24rpx 24rpx 24rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.coupon-info {
  flex: 1;
}

.coupon-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.coupon-condition {
  font-size: 24rpx;
  color: #E95F3C;
  margin-bottom: 6rpx;
}

.coupon-time {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 6rpx;
}

.coupon-scope {
  font-size: 22rpx;
  color: #666;
  display: inline-block;
  padding: 2rpx 10rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
}

.coupon-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: 20rpx;
}

.remain-count {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.receive-btn {
  width: 140rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  background: linear-gradient(135deg, #E95F3C 0%, #ff7a5c 100%);
  color: #fff;
  font-size: 24rpx;
  border-radius: 28rpx;
  padding: 0;
  margin: 0;
  border: none;
}

.receive-btn::after {
  border: none;
}

.receive-btn[disabled] {
  background: #ccc;
  color: #fff;
}

.received-btn {
  background: #ccc !important;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.loading-state {
  text-align: center;
  padding: 40rpx 0;
}

.loading-text {
  font-size: 26rpx;
  color: #999;
}
