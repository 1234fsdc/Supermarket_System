.pay-page {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 130rpx;
}

/* 金额区 */
.amount-section {
  background: var(--tm-red-gradient-soft);
  color: #fff;
  padding: 48rpx 24rpx 40rpx;
  text-align: center;
}
.a-label { font-size: 26rpx; opacity: 0.9; }
.a-value {
  font-size: 72rpx;
  font-weight: 700;
  margin-top: 16rpx;
  letter-spacing: -2rpx;
}
.a-value .unit {
  font-size: 36rpx;
  margin-right: 4rpx;
}
.a-countdown {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 24rpx;
  opacity: 0.9;
}
.cd-box {
  background: rgba(0,0,0,0.2);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-family: "Courier New", monospace;
  font-size: 28rpx;
  font-weight: 700;
}

/* 支付方式 */
.method-card {
  background: #fff;
  margin: 20rpx;
  border-radius: var(--radius-lg);
  padding: 24rpx;
  box-shadow: var(--shadow-card);
}
.m-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}
.m-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}
.m-item:last-child { border-bottom: none; }
.m-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}
.m-info { flex: 1; }
.m-name { font-size: 28rpx; font-weight: 600; display: block; }
.m-desc { font-size: 22rpx; color: var(--text-tertiary); margin-top: 2rpx; }
.m-radio {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border-medium);
}
.m-radio.on {
  background: var(--tm-red);
  border-color: var(--tm-red);
  display: flex;
  align-items: center;
  justify-content: center;
}
.m-radio.on::after {
  content: '';
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #fff;
}

/* 底部 */
.pay-bottom {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid var(--border-light);
}
.p-cancel {
  font-size: 28rpx;
  color: var(--text-secondary);
  padding: 16rpx;
}
