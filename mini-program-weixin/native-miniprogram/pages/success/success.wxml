<view class="success-page">
  <view class="s-top-bar"></view>

  <view class="s-card">
    <text class="s-icon">✅</text>
    <text class="s-title">支付成功</text>
    <text class="s-sub">订单已通知商家，正在准备商品</text>
    <view class="s-amount-row">
      <text class="s-am-label">实付</text>
      <text class="s-am-value">¥{{amount}}</text>
    </view>
    <text class="s-order-id">订单号：{{orderId || '生成中...'}}</text>
  </view>

  <view class="s-bottom safe-bottom">
    <view class="btn-outline" bindtap="goOrderDetail" style="flex:1;height:80rpx;display:flex;align-items:center;justify-content:center;">查看订单</view>
    <view class="btn-primary" bindtap="goContinue" style="flex:1;height:80rpx;display:flex;align-items:center;justify-content:center;font-size:30rpx;">继续逛逛 {{countdown}}s</view>
  </view>
</view>
