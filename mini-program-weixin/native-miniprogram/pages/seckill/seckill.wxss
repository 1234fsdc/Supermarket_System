.seckill-page {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 40rpx;
}

/* 头部 */
.sk-header {
  position: relative;
  height: 260rpx;
  overflow: hidden;
}
.sk-header-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, #CC002B 0%, var(--tm-red) 100%);
}
.sk-header-content {
  position: relative;
  padding: 40rpx 28rpx;
  color: #fff;
}
.sk-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.sk-big-icon { font-size: 56rpx; }
.sk-title {
  font-size: 40rpx;
  font-weight: 700;
  display: block;
}
.sk-sub {
  font-size: 24rpx;
  opacity: 0.9;
  display: block;
  margin-top: 4rpx;
}
.sk-countdown {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.sk-cd-label { font-size: 24rpx; }
.sk-cd-time {
  background: rgba(0,0,0,0.3);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  padding: 8rpx 20rpx;
  border-radius: 10rpx;
  font-family: "Courier New", monospace;
}

/* 活动介绍 */
.sk-intro {
  margin: -32rpx 20rpx 0;
  background: #fff;
  border-radius: var(--radius-lg);
  padding: 24rpx;
  box-shadow: var(--shadow-card);
  position: relative;
  z-index: 2;
}
.sk-intro-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
}
.sk-intro-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
}

.sk-section-title {
  padding: 28rpx 24rpx 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.sk-count {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-tertiary);
}

/* 商品网格 */
.sk-grid {
  padding: 0 20rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.sk-card {
  background: #fff;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(204,0,43,0.05);
  display: flex;
  flex-direction: column;
}
.sk-img-wrap {
  position: relative;
  width: 100%;
  height: 260rpx;
  background: #F8F8F8;
}
.sk-img {
  width: 100%;
  height: 100%;
}
.sk-badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background: var(--tm-red-gradient);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 4rpx;
}

.sk-info {
  padding: 16rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
}
.sk-name {
  font-size: 26rpx;
  color: var(--text-primary);
  line-height: 1.4;
  min-height: 72rpx;
}
.sk-price-row {
  margin-top: 8rpx;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}
.sk-price {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--tm-red);
}
.sk-price .unit {
  font-size: 22rpx;
  margin-right: 2rpx;
}
.sk-old {
  font-size: 22rpx;
  color: var(--text-tertiary);
  text-decoration: line-through;
}

.sk-progress {
  margin-top: 10rpx;
}
.sk-prog-text {
  font-size: 20rpx;
  color: var(--tm-red);
  margin-bottom: 6rpx;
  display: block;
}
.sk-prog-bar {
  height: 8rpx;
  background: var(--bg-tag-red);
  border-radius: 4rpx;
  overflow: hidden;
}
.sk-prog-fill {
  height: 100%;
  background: var(--tm-red-gradient);
  border-radius: 4rpx;
  transition: width 0.3s;
}

.sk-btn {
  margin-top: 12rpx;
  height: 60rpx;
  background: var(--tm-red-gradient);
  color: #fff;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  box-shadow: 0 2rpx 8rpx rgba(255,0,54,0.2);
}

/* 说明 */
.sk-footer {
  margin: 32rpx 20rpx 0;
  background: #FFF8E1;
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}
