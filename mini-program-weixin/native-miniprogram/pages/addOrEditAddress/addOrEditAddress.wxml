<view class="edit-addr-page">
  <view class="form-card">
    <view class="form-item">
      <text class="label">收货人</text>
      <input class="input" placeholder="请输入姓名" value="{{consignee}}" data-field="consignee" bindinput="onInput" />
    </view>
    <view class="form-item">
      <text class="label">手机号</text>
      <input class="input" placeholder="请输入手机号" value="{{phone}}" data-field="phone" bindinput="onInput" type="number" maxlength="11" />
    </view>
    <view class="form-item">
      <text class="label">性别</text>
      <radio-group class="radio-group" bindchange="onSexChange">
        <label class="radio-item">
          <radio value="0" color="#FF0036" checked="{{sex === '0'}}" />先生
        </label>
        <label class="radio-item">
          <radio value="1" color="#FF0036" checked="{{sex === '1'}}" />女士
        </label>
      </radio-group>
    </view>
    <view class="form-item">
      <text class="label">所在地区</text>
      <view class="region-row">
        <text class="region-item">{{provinceName}}</text>
        <text class="region-item">{{cityName}}</text>
        <text class="region-item">{{districtName}}</text>
        <text class="region-arrow">›</text>
      </view>
    </view>
    <view class="form-item detail-item">
      <text class="label">详细地址</text>
      <textarea class="textarea" placeholder="街道、楼栋号、门牌号等" value="{{detail}}" data-field="detail" bindinput="onInput" auto-height="true" />
    </view>
  </view>

  <view class="form-card">
    <view class="form-item tag-section">
      <text class="label">标签</text>
      <view class="tag-list">
        <view class="label-tag {{label === 'home' ? 'active' : ''}}" data-label="home" bindtap="onLabelChange">🏠 家</view>
        <view class="label-tag {{label === 'company' ? 'active' : ''}}" data-label="company" bindtap="onLabelChange">🏢 公司</view>
        <view class="label-tag {{label === 'school' ? 'active' : ''}}" data-label="school" bindtap="onLabelChange">🎓 学校</view>
      </view>
    </view>
    <view class="form-item">
      <text class="label">设为默认</text>
      <switch checked="{{isDefault === 1}}" color="#FF0036" bindchange="onSwitchDefault" />
    </view>
  </view>

  <view class="save-bar safe-bottom">
    <view class="save-btn" bindtap="onSave">保存地址</view>
  </view>
</view>