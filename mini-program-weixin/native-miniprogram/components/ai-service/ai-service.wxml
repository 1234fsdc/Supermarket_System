<!-- 木东小蜜 AI 客服 -->
<view class="ai-fab" bindtap="toggle" wx:if="{{!visible}}">
  <text class="ai-fab-icon">🤖</text>
</view>

<view class="ai-mask" wx:if="{{visible}}" bindtap="close">
  <view class="ai-panel" catchtap="">
    <view class="panel-header">
      <view class="panel-header-left">
        <text class="panel-avatar">🤖</text>
        <view>
          <text class="panel-title">木东小蜜</text>
          <text class="panel-sub">智能助手 在线为您服务</text>
        </view>
      </view>
      <text class="panel-close" bindtap="close">✕</text>
    </view>

    <scroll-view class="msg-list" scroll-y="true" scroll-into-view="msg-{{messages.length - 1}}" scroll-with-animation="{{true}}">
      <block wx:for="{{messages}}" wx:key="index">
        <view id="msg-{{index}}" class="msg-item {{item.role === 'user' ? 'right' : 'left'}}">
          <view class="msg-avatar">{{item.role === 'user' ? '🙂' : '🤖'}}</view>
          <view class="msg-bubble {{item.role === 'user' ? 'user' : 'bot'}}">
            <text class="msg-text">{{item.text}}</text>
          </view>
        </view>
      </block>
      <view class="thinking" wx:if="{{sending}}">
        <view class="thinking-bubble">
          <text>思考中</text>
          <text class="d1">.</text>
          <text class="d2">.</text>
          <text class="d3">.</text>
        </view>
      </view>
    </scroll-view>

    <view class="quick-q" wx:if="{{messages.length <= 1}}">
      <view class="q-list">
        <block wx:for="{{quickQuestions}}" wx:key="*this">
          <view class="q-item" data-q="{{item}}" bindtap="pickQuestion">{{item}}</view>
        </block>
      </view>
    </view>

    <view class="input-area">
      <input class="msg-input" placeholder="输入您的问题..." value="{{inputText}}" bindinput="onInput" confirm-type="send" bindconfirm="send" />
      <view class="send-btn {{inputText.trim() ? 'active' : ''}}" bindtap="send">
        <text>发送</text>
      </view>
    </view>
  </view>
</view>
