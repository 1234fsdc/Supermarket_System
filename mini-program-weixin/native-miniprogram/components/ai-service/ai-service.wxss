/* AI 客服 - 木东小蜜 */
.ai-fab {
  position: fixed;
  right: 24rpx;
  bottom: 160rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--tm-red);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(255, 0, 54, 0.3);
  z-index: 999;
}
.ai-fab-icon {
  font-size: 40rpx;
}

/* 弹窗 */
.ai-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 9999;
  display: flex;
  align-items: flex-end;
}
.ai-panel {
  width: 100%;
  height: 85vh;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 头部 */
.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx 16rpx;
  border-bottom: 1rpx solid var(--border-light);
}
.panel-header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.panel-avatar { font-size: 40rpx; }
.panel-title {
  font-size: 30rpx;
  font-weight: 700;
  display: block;
}
.panel-sub {
  font-size: 20rpx;
  color: var(--text-tertiary);
}
.panel-close {
  font-size: 32rpx;
  color: #999;
  padding: 8rpx;
}

/* 消息列表 */
.msg-list {
  flex: 1;
  padding: 20rpx 24rpx;
  background: #F8F8F8;
}
.msg-item {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.msg-item.right {
  flex-direction: row-reverse;
}
.msg-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}
.msg-bubble {
  max-width: 70%;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 1.5;
  word-break: break-all;
}
.msg-bubble.bot {
  background: #fff;
  color: var(--text-primary);
  border: 1rpx solid var(--border-light);
}
.msg-bubble.user {
  background: var(--tm-red);
  color: #fff;
}
.msg-text {
  display: block;
}

/* 思考动画 */
.thinking {
  padding: 20rpx 0;
}
.thinking-bubble {
  display: inline-block;
  background: #fff;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: var(--text-tertiary);
  border: 1rpx solid var(--border-light);
}
.d1, .d2, .d3 {
  animation: dot 1.5s infinite;
}
.d2 { animation-delay: 0.3s; }
.d3 { animation-delay: 0.6s; }
@keyframes dot {
  0%, 60%, 100% { opacity: 0; }
  30% { opacity: 1; }
}

/* 快捷问题 */
.quick-q {
  padding: 12rpx 24rpx 8rpx;
  border-top: 1rpx solid var(--border-light);
  background: #fff;
}
.q-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.q-item {
  padding: 8rpx 20rpx;
  background: var(--bg-tag-red);
  color: var(--tm-red);
  border-radius: 28rpx;
  font-size: 22rpx;
  white-space: nowrap;
}

/* 输入区 */
.input-area {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid var(--border-light);
  gap: 16rpx;
}
.msg-input {
  flex: 1;
  height: 72rpx;
  background: #F5F5F5;
  border-radius: 36rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
}
.send-btn {
  min-width: 100rpx;
  height: 72rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-tertiary);
  background: #F0F0F0;
}
.send-btn.active {
  background: var(--tm-red);
  color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(255,0,54,0.2);
}
