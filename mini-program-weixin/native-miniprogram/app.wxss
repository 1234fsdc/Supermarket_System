/**
 * 木东超市 - 全局样式
 * 设计系统：木东 APP 红白精奢风格 v2.0
 */

/* ===== 设计令牌 ===== */
page {
  /* 木东品牌色 */
  --tm-red: #FF0036;
  --tm-red-light: #FF6A81;
  --tm-red-dark: #CC002B;
  --tm-red-gradient: linear-gradient(135deg, #FF0036 0%, #FF6A81 100%);
  --tm-red-gradient-soft: linear-gradient(135deg, #FF0036 0%, #FF4D6A 100%);

  /* 辅助色 */
  --tm-orange: #FF6A00;
  --tm-yellow: #FFD000;
  --tm-green: #00B578;
  --tm-blue: #1677FF;
  --tm-gold: #FFD700;

  /* 背景色 */
  --bg-page: #F5F5F5;
  --bg-card: #FFFFFF;
  --bg-tag-red: #FFF0F3;
  --bg-tag-orange: #FFF5EB;
  --bg-tag-green: #E8F8F0;

  /* 文字色 */
  --text-primary: #111111;
  --text-secondary: #666666;
  --text-tertiary: #999999;
  --text-placeholder: #C0C0C0;
  --text-white: #FFFFFF;

  /* 边框 */
  --border-light: #F0F0F0;
  --border-medium: #E0E0E0;

  /* 圆角 */
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-xl: 24rpx;
  --radius-round: 999rpx;

  /* 阴影 */
  --shadow-card: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  --shadow-strong: 0 6rpx 20rpx rgba(255, 0, 54, 0.15);
  --shadow-elevated: 0 8rpx 30rpx rgba(0, 0, 0, 0.08);
  --shadow-tag: 0 4rpx 12rpx rgba(255, 0, 54, 0.25);

  background: var(--bg-page);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: var(--text-primary);
  height: 100%;
  -webkit-font-smoothing: antialiased;
  box-sizing: border-box;
}

/* ===== 价格体系 ===== */
.price-now {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--tm-red);
}
.price-now .unit {
  font-size: 24rpx;
  font-weight: 600;
}
.price-old {
  font-size: 24rpx;
  color: var(--text-tertiary);
  text-decoration: line-through;
}
.price-big {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--tm-red);
  letter-spacing: -1rpx;
}
.price-big .unit {
  font-size: 28rpx;
  font-weight: 600;
}

/* ===== 标签徽章 ===== */
.tm-tag {
  display: inline-block;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  border-radius: 4rpx;
  font-weight: 500;
  margin-right: 6rpx;
  line-height: 1.4;
}
.tm-tag-red { background: var(--bg-tag-red); color: var(--tm-red); }
.tm-tag-orange { background: var(--bg-tag-orange); color: var(--tm-orange); }
.tm-tag-green { background: var(--bg-tag-green); color: var(--tm-green); }
.tm-tag-white { background: rgba(255,255,255,0.2); color: #fff; }

/* 订单状态标签 */
.tag-status-1 { background: var(--bg-tag-red); color: var(--tm-red); }
.tag-status-2 { background: #FFF5EB; color: #E67E17; }
.tag-status-3 { background: #E8F5FF; color: #1677FF; }
.tag-status-4 { background: #FFF0E6; color: #FF6A00; }
.tag-status-5 { background: #E8F8F0; color: #00B578; }
.tag-status-6 { background: #F5F5F5; color: #999; }

/* ===== 按钮 ===== */
.btn-primary {
  background: var(--tm-red-gradient);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  padding: 22rpx 0;
  border: none;
  letter-spacing: 1rpx;
  box-shadow: var(--shadow-tag);
  transition: opacity 0.2s;
  position: relative;
  overflow: hidden;
}
.btn-primary:active { opacity: 0.92; transform: scale(0.98); }
.btn-primary::after { border: none; }
.btn-primary.disabled {
  background: linear-gradient(135deg, #FFB0C0 0%, #FFC8D0 100%);
  box-shadow: none;
}

.btn-outline {
  background: #fff;
  color: var(--tm-red);
  border: 2rpx solid var(--tm-red);
  border-radius: 44rpx;
  font-size: 28rpx;
  text-align: center;
  padding: 20rpx 0;
  font-weight: 500;
  transition: all 0.2s;
}
.btn-outline::after { border: none; }
.btn-outline:active { background: var(--bg-tag-red); }

/* ===== 卡片容器 ===== */
.tm-card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  margin: 0 20rpx 16rpx;
  box-shadow: var(--shadow-card);
}
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  padding: 28rpx 20rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.section-title .more {
  font-size: 24rpx;
  color: var(--text-tertiary);
  font-weight: 400;
}

/* ===== 导航栏头部 ===== */
.tm-header {
  background: #fff;
  position: relative;
  z-index: 10;
}
.tm-header .header-bar {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx 12rpx 24rpx;
  gap: 16rpx;
}
.tm-header .search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #F5F5F5;
  border-radius: var(--radius-round);
  padding: 0 24rpx;
  height: 64rpx;
}
.tm-header .search-box .s-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  color: var(--text-tertiary);
}
.tm-header .search-box .s-text {
  font-size: 26rpx;
  color: var(--text-placeholder);
}
.tm-header .h-icon {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  background: #F5F5F5;
  border-radius: 50%;
}

/* ===== 文本工具 ===== */
.text-primary { color: var(--text-primary); }
.text-secondary { color: var(--text-secondary); }
.text-tertiary { color: var(--text-tertiary); }
.text-red { color: var(--tm-red); }
.text-white { color: #fff; }
.text-bold { font-weight: 600; }

.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.text-ellipsis-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ===== 布局工具 ===== */
.flex { display: flex; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-1 { flex: 1; }
.flex-column { display: flex; flex-direction: column; }
.flex-wrap { flex-wrap: wrap; }
.gap-8 { gap: 8rpx; }
.gap-12 { gap: 12rpx; }
.gap-16 { gap: 16rpx; }
.gap-20 { gap: 20rpx; }
.gap-24 { gap: 24rpx; }

/* ===== 间距 ===== */
.mt-4 { margin-top: 4rpx; }
.mt-8 { margin-top: 8rpx; }
.mt-12 { margin-top: 12rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-24 { margin-top: 24rpx; }
.mb-8 { margin-bottom: 8rpx; }
.mb-12 { margin-bottom: 12rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.ml-8 { margin-left: 8rpx; }
.ml-12 { margin-left: 12rpx; }
.mr-8 { margin-right: 8rpx; }
.mr-12 { margin-right: 12rpx; }
.ph-20 { padding-left: 20rpx; padding-right: 20rpx; }
.ph-24 { padding-left: 24rpx; padding-right: 24rpx; }

/* ===== 通用容器 ===== */
.page-container {
  min-height: 100vh;
  padding-bottom: 130rpx;
}
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* ===== 加载与空状态 ===== */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  color: var(--text-tertiary);
  font-size: 26rpx;
}

/* ===== 分隔线 ===== */
.divider {
  height: 1rpx;
  background: var(--border-light);
  margin: 0 20rpx;
}

/* ===== 浮动按钮 ===== */
.fab-tmall {
  position: fixed;
  right: 24rpx;
  bottom: 200rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--tm-red);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  box-shadow: var(--shadow-strong);
  z-index: 999;
}

/* ===== 淡入动画 ===== */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.ani-fade-in {
  animation: fadeIn 0.3s ease-out;
}

/* ===== 缩放点击效果 ===== */
.scale-active:active {
  transform: scale(0.96);
  opacity: 0.9;
}
